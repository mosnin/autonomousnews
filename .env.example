# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=https://technotimes.com
NEXT_PUBLIC_SITE_NAME=Techno Times

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Agent pipeline (used by hourly worker, not by the web app)
OPENAI_API_KEY=
NEWSAPI_KEY=             # https://newsapi.org/
THENEWSAPI_TOKEN=        # https://www.thenewsapi.com/
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
ADMIN_API_KEY=           # Bearer token the agent worker uses to call /api/admin/*
