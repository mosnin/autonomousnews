# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://technotimes.com
NEXT_PUBLIC_SITE_NAME=Techno Times
NEXT_PUBLIC_CONTACT_EMAIL=hello@technotimes.com
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Techno Times
NEXT_PUBLIC_GOVERNING_LAW_STATE=Delaware     # the U.S. state whose laws govern your Terms
NEXT_PUBLIC_SOURCE_REPO_URL=https://github.com/yourorg/technotimes  # shown on /agents

# --- Editor on duty (single-editor masthead) ---
# Identifies the human who reviews the agent audit queue and signs off on
# every published article. All optional — when unset the site shows a
# neutral "Editor on Duty" placeholder, never a TODO or an un-consented name.
NEXT_PUBLIC_EDITOR_NAME=                     # e.g. Jordan Rivera
NEXT_PUBLIC_EDITOR_TITLE=                    # e.g. Editor, Techno Times
NEXT_PUBLIC_EDITOR_BIO=                      # one-line bio
NEXT_PUBLIC_EDITOR_LINK_X=                   # full URL or @handle
NEXT_PUBLIC_EDITOR_LINK_LINKEDIN=            # full URL
NEXT_PUBLIC_EDITOR_LINK_WEB=                 # full URL

# --- Admin ---
ADMIN_PASSWORD=                  # password for /admin login
ADMIN_API_KEY=                   # bearer token the agent worker uses for /api/agent/*
DAILY_BUDGET_USD=10              # hard cap before agent worker stops spawning new runs

# --- Monetization ---
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# --- Analytics & SEO ---
NEXT_PUBLIC_GA4_ID=              # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=    # e.g. technotimes.com
NEXT_PUBLIC_GSC_VERIFICATION=    # Google Search Console site-verification token
INDEXNOW_KEY=                    # random ~32-char hex string

# --- Rate limiting (optional but recommended for production) ---
# Free tier at https://upstash.com — leave blank in dev/CI to skip limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Agent worker (Modal + OpenAI Agents SDK) ---
OPENAI_API_KEY=
NEWSAPI_KEY=                     # https://newsapi.org/
THENEWSAPI_TOKEN=                # https://www.thenewsapi.com/
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
